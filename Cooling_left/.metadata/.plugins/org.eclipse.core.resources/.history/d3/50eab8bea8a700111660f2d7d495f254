#include "MY_driver_fan.h"
#include "MY_driver_can.h"
#include "MY_driver_i2c.h"
/* ================= PRIVATE VARIABLE ================= */

static uint8_t fan1Pulse = 0;
static uint8_t fan2Pulse = 0;

float  batteryMaxTemp = 0;

/* ================= PRIVATE FUNCTION DECLARATIONS ================= */

static float FAN_SetMaxTempPacket(uint8_t* data);


/* ================= API ================= */


/**
 * @brief Populates the CAN data buffer with the current pulse values of both fans.
 *
 * @param data  Pointer to a byte array of at least 2 bytes; filled with fan 1 and fan 2 pulse values.
 */
void FAN_FetcherPulse(uint8_t *data)
{
	data[0] = fan1Pulse;
	data[1] = fan2Pulse;
}

/**
 * @brief Sets PWM pulse widths for cabin fan channel

 * @param pulseTable     Desired pulse value for fan 2 (TIM_CHANNEL_2), range 0–100.
 */
void FAN_SetPulseExternCabin(uint8_t* pulseTable)
{
	fan2Pulse = pulseTable[0];
}

/**
 * @brief Resets the pulse values of both fans to zero.
 */
void FAN_PulseReset()
{
	fan1Pulse = 100;
	fan2Pulse = 100;
}

/**
 * @brief Switches individual fans or both fans on or off via GPIO.
 *
 * @param setter    Desired fan state from fan_state_e.
 */
void FAN_SetOnOff(fan_state_e setter)
{
	switch (setter)
	{
	case FAN_ON_1:
		HAL_GPIO_WritePin(FAN1_ON_GPIO_Port, FAN1_ON_Pin, GPIO_PIN_SET);
		break;

	case FAN_OFF_1:
		HAL_GPIO_WritePin(FAN1_ON_GPIO_Port, FAN1_ON_Pin, GPIO_PIN_RESET);
		break;

	case FAN_ON_2:
		HAL_GPIO_WritePin(FAN2_ON_GPIO_Port, FAN2_ON_Pin, GPIO_PIN_SET);
		break;

	case FAN_OFF_2:
		HAL_GPIO_WritePin(FAN2_ON_GPIO_Port, FAN2_ON_Pin, GPIO_PIN_RESET);
		break;

	case FAN_ON_BOTH:
		HAL_GPIO_WritePin(FAN1_ON_GPIO_Port, FAN1_ON_Pin, GPIO_PIN_SET);
		HAL_GPIO_WritePin(FAN2_ON_GPIO_Port, FAN2_ON_Pin, GPIO_PIN_SET);
		break;

	case FAN_OFF_BOTH:
		HAL_GPIO_WritePin(FAN1_ON_GPIO_Port, FAN1_ON_Pin, GPIO_PIN_RESET);
		HAL_GPIO_WritePin(FAN2_ON_GPIO_Port, FAN2_ON_Pin, GPIO_PIN_RESET);
		break;
	}
}

/**
 * @brief Updates the battery temperature packet buffer and recalculates the maximum battery temperature.
 *
 * Stores the incoming CAN frame's converted temperature value at the index given by
 * @p frame->name, then scans the whole packet buffer to find and store the highest
 * temperature value in the global @ref batteryMaxTemp.
 *
 * @param frame  Pointer to the received CAN buffer frame containing the raw temperature data.
 */
void FAN_SetMaxTemp(struct CAN_bufferFrame* frame)
{
	static float  tempPacket[NUMBER_OF_PACKET] = {0};
	float maxTemp = 0;

	tempPacket[frame->name] = FAN_SetMaxTempPacket(frame->data);
	for(uint8_t i = 0; i < NUMBER_OF_PACKET; ++i)
	{
		if(maxTemp < tempPacket[i])
		{
			maxTemp = tempPacket[i];
		}
	}
	batteryMaxTemp = maxTemp;

}

/**
 * @brief Regulates fan 1 PWM duty cycle based on the current battery temperature.
 *
 * Runs periodically (every @ref DT ms). Duty cycle scales linearly with
 * @ref batteryMaxTemp above 30°C, is forced to 0 below 30°C, and is clamped
 * to a maximum of 100.
 */
void FAN_BatteryController() // Fix it during tests
{
	static uint8_t pwmDuty = 0;
	static uint32_t lastTick = 0;

	if(HAL_GetTick() - lastTick >= DT)
	{
		lastTick = HAL_GetTick();

		pwmDuty = 100 - ((batteryMaxTemp) + 5)*2;
		if(batteryMaxTemp < 20)
		{
			FAN_SetOnOff(FAN_OFF_1);
			pwmDuty = 100;
		}
		else if(batteryMaxTemp > 50)
		{
			FAN_SetOnOff(FAN_ON_1);
			pwmDuty = 0;
		}
		else
		{
			FAN_SetOnOff(FAN_ON_1);
		}
	}
	fan1Pulse = pwmDuty;
}

/**
 * @brief Regulates fan 2 PWM duty cycle based on the cabin temperature read from the AM2320 sensor.
 *
 * Runs periodically (every @ref DT ms). Reads temperature and humidity from the AM2320
 * sensor, then scales the duty cycle linearly with temperature above 20.0°C (tempX10 > 200),
 * forces it to 0 below that threshold, and clamps it to a maximum of 100.
 */
void FAN_CabinController() // Fix it during tests
{
	static uint32_t lastTick = 0;
	static uint8_t pwmDuty = 0;
	static int16_t tempX10 = 0;
	static uint16_t humX10 = 0;


	if(HAL_GetTick() - lastTick >= DT)
	{
		lastTick = HAL_GetTick();
		AM2320_GetTempHum(&tempX10, &humX10);
		pwmDuty = 100 - (tempX10 - 200);

		if(tempX10 < 200)
		{
			FAN_SetOnOff(FAN_OFF_2);
			pwmDuty = 100;
		}
		else if(tempX10 > 300)
		{
			FAN_SetOnOff(FAN_ON_2);
			pwmDuty = 0;
		}
		else
		{
			FAN_SetOnOff(FAN_ON_2);
		}
		fan2Pulse = pwmDuty;
	}
}


/**
 * @brief Applies current fan pulse values to the PWM timer channels and schedules a CAN status frame.
 *
 * Removes any previously scheduled CAN message for the left cooling fan, applies the
 * stored @ref fan1Pulse and @ref fan2Pulse values to TIM_CHANNEL_1 and TIM_CHANNEL_2,
 * then re-registers a periodic CAN frame reporting both pulse values.
 *
 * @param htim          Pointer to the timer handle controlling the fan PWM output.
 * @param CAN_Buffer_TX Pointer to the CAN scheduled message list used for TX.
 */
void FAN_SetPulseInternal(TIM_HandleTypeDef *htim, struct CAN_scheduledMsgList *CAN_Buffer_TX)
{
	CAN_RemoveScheduledMsg(ID_COOLING_LEFT_FAN, CAN_Buffer_TX);

	__HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_1, fan1Pulse);
	__HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_2, fan2Pulse);

	CAN_WriteFrame(CAN_Buffer_TX, ID_COOLING_LEFT_FAN, BYTE_SIZE_PULSE, FAN_FetcherPulse, PERIOD_PULSE_SEND);
}


/* ================= PRIVATE ================= */

/**
 * @brief Finds the highest raw temperature value within a received CAN data packet.
 *
 * @param data  Pointer to the byte array containing raw per-cell/per-sensor temperature values.
 * @return      The highest temperature value found in the packet, as a float.
 */
static float FAN_SetMaxTempPacket(uint8_t* data)
{
	float maxTemp = 0;

	for(uint8_t i = 0; i < NUMBER_OF_PACKET; ++i)
	{
		if(maxTemp < data[i])
		{
			maxTemp = data[i];
		}
	}
	//return (float)maxTemp;
	return (float)maxTemp * TEMP_FACTOR + TEMP_OFFSET; //CHANGE IT WHEN TESTING WITH BMS;
}
