		case(CAN_FRAME_BMS_TEMP_4):
			tempPacket[3] = FAN_SetMaxTempPacket(frame->data);

		case(CAN_FRAME_BMS_TEMP_5):
			tempPacket[4] = FAN_SetMaxTempPacket(frame->data);

		case(CAN_FRAME_BMS_TEMP_6):
			tempPacket[5] = FAN_SetMaxTempPacket(frame->data);

		case(CAN_FRAME_BMS_TEMP_7):
			tempPacket[6] = FAN_SetMaxTempPacket(frame->data);

		case(CAN_FRAME_BMS_TEMP_8):
			tempPacket[7] = FAN_SetMaxTempPacket(frame->data);

		case(CAN_FRAME_BMS_TEMP_9):
			tempPacket[8] = FAN_SetMaxTempPacket(frame->data);
	}

	for(uint8_t i = 0; i < NUMBER_OF_PACKET; ++i)
	{
		if(maxTemp < tempPacket[i])
		{
			maxTemp = tempPacket[i];
		}
	}
	batteryMaxTemp = maxTemp;
}

