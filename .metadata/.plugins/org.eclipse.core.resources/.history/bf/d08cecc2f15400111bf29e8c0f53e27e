/* ================= PRIVATE ================= */
static void FAN_SetMaxTempPacket(uint8_t* data)
{
	uint8_t sizeData = sizeof(data)/sizeof(data[0]);
	float maxTemp = 0;

	for(uint8_t i = 0; i < sizeData; ++i)
	{
		if(maxTemp < data[i])
		{
			maxTemp = data[i];
		}
	}

	return maxTemp * TEMP_FACTOR + TEMP_OFFSET;
}



