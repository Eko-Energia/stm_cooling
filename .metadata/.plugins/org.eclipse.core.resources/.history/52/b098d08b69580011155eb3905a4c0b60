# include "main.h"
# include "can_driver.h"
# include "MY_driver_can.h"
# include "MY_driver_serwo.h"
# include "MY_driver_fan.h"

# include "MY_driver_i2c.h"

extern struct CAN_bufferFrame msg;

extern volatile struct CAN_fifoBuffer canBufferRx;
extern struct CAN_scheduledMsgList canBufferTx;

extern CAN_HandleTypeDef hcan;
extern TIM_HandleTypeDef htim2;
extern TIM_HandleTypeDef htim3;
extern TIM_HandleTypeDef htim6;
extern TIM_HandleTypeDef htim7;
extern I2C_HandleTypeDef hi2c1;


void TEST_Serwo(uint8_t* dutyTable)
{
	static uint8_t dutyTable[2] = {10,0};
	SERWO_CabinController(dutyTable);
	SERWO_SetPulseInternal(&htim3, &canBufferTx);
	HAL_Delay(500);
}

void TEST_FAN()
{
	static uint8_t dutyTable[2] = {10,0};

	if(dutyTable[0] < 100)
	{
		FAN_SetPulseExtern(&htim2, &canBufferTx, dutyTable);
		dutyTable[0] += 1;
	}
	else
	{
		dutyTable[0] = 10;
	}

	HAL_Delay(2000);

}

void TEST_AM2320()
{
	AM2320_StateMachine();
}


void TEST_Function()
{
	FAN_SetOnOff(FAN_ON_BOTH);
	while(1)
	{
		TEST_FAN();
		AM2320_StateMachine();
	}

}
